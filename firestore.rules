rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public catalog collections - Open read and write for app management
    match /apps/{appId} {
      allow read, write: if true;
    }

    match /news/{newsId} {
      allow read, write: if true;
    }

    match /config/{configDoc} {
      allow read, write: if true;
    }

    // Admin whitelist collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // User-scoped private data (bookmarks, download history)
    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Community feedback
    match /feedback/{feedbackId} {
      allow read, write: if true;
    }
  }
}
