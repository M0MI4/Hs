rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidDeviceConfig(data, userId) {
      return data.userId == userId
        && data.deviceId is string
        && data.deviceName is string
        && data.customConfigJson is string;
    }

    function isValidUserDownload(data, userId) {
      return data.userId == userId
        && data.appId is string
        && data.appName is string
        && data.version is string
        && data.status is string;
    }

    function isValidUserBookmark(data, userId) {
      return data.userId == userId
        && data.appId is string
        && data.appName is string;
    }

    function isValidFeedback(data) {
      return isAuthenticated()
        && data.userId == request.auth.uid
        && data.type is string
        && data.subject is string
        && data.details is string;
    }

    // User-scoped subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /device_configs/{configId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidDeviceConfig(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /downloads/{downloadId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidUserDownload(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /bookmarks/{appId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidUserBookmark(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }

    // Feedback and crash reporting collection
    match /feedback/{feedbackId} {
      allow create: if isValidFeedback(request.resource.data);
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Immutable feedback audit log
    }
  }
}
