rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admins identified by custom claims or registered admin UIDs or authenticated admin users
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email != null
      );
    }

    // Public catalog collections - Anyone can view, only verified admins can modify
    match /apps/{appId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /config/{configDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin whitelist collection (read-only verification)
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == adminId;
    }

    // User-scoped private data (bookmarks, download history)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }
  }
}
